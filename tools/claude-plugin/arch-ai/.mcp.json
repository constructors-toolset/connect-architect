{
  "mcpServers": {
    "arch-ai": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/archai",
      "args": ["mcp"],
      "env": {
        "LAW_OC": "${LAW_OC:-}",
        "KCSC_API_KEY": "${KCSC_API_KEY:-}",
        "DATA_GO_KR_KEY": "${DATA_GO_KR_KEY:-}",
        "ARCHAI_BOM_DB": "${ARCHAI_BOM_DB:-data/processed/bom/arch-bom.sqlite}"
      }
    },
    "ifc-openshell": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/archai",
      "args": ["ifcmcp"]
    },
    "korean-law": {
      "command": "npx",
      "args": ["-y", "--ignore-scripts", "--omit=optional", "korean-law-mcp@4"],
      "env": {
        "LAW_OC": "${LAW_OC:-}"
      }
    }
  }
}
